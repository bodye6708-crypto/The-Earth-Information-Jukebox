# Earth Information Jukebox - Environment Configuration Example
APP_NAME="Earth Information Jukebox API"
ENVIRONMENT="production"
PORT=8000
DATABASE_URL="sqlite:///./earth_jukebox.db"

# Set a cryptographically secure random string in production (min 32 chars)
# e.g., generated with: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-production-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Master Key for privileged auditing & administration
ADMIN_API_KEY="replace-with-a-secure-admin-api-key"

# CORS Production Domain Allowlist (comma-separated, NO WILDCARDS in production)
CORS_ORIGINS="https://the-earth-information-jukebox.vercel.app,http://localhost:5173,http://localhost:3000"
